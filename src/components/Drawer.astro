---
const pathname = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? pathname === '/' : pathname.startsWith(href);
---
<div id="drawer" class="fixed inset-0 z-50 flex -translate-x-full bg-black/80 transition-transform duration-300" aria-hidden="true">
  <div class="w-64 bg-pureBlack border-r border-borderLine h-full p-6 flex flex-col justify-between relative z-10">
    <div class="space-y-6">
      <div class="flex items-center justify-between">
        <span class="text-sm font-bold text-white tracking-wide">Calvo Blog</span>
        <button id="close-drawer" class="text-slate-400 hover:text-white transition-colors" aria-label="Cerrar menú">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
      <nav class="flex flex-col space-y-3 text-xs font-medium">
        <a href="/" class:list={['rounded-lg px-3 py-2 transition', isActive('/') ? 'bg-white/10 font-bold text-white' : 'text-slate-400 hover:text-white']} aria-current={isActive('/') ? 'page' : undefined}>Inicio</a>
        <a href="/explorar" class:list={['rounded-lg px-3 py-2 transition', isActive('/explorar') ? 'bg-white/10 font-bold text-white' : 'text-slate-400 hover:text-white']} aria-current={isActive('/explorar') ? 'page' : undefined}>Explorar</a>
        <a href="/tutoriales" class:list={['rounded-lg px-3 py-2 transition', isActive('/tutoriales') ? 'bg-white/10 font-bold text-white' : 'text-slate-400 hover:text-white']} aria-current={isActive('/tutoriales') ? 'page' : undefined}>Tutoriales</a>
        <a href="/guias" class:list={['rounded-lg px-3 py-2 transition', isActive('/guias') ? 'bg-white/10 font-bold text-white' : 'text-slate-400 hover:text-white']} aria-current={isActive('/guias') ? 'page' : undefined}>Guías</a>
        <a href="/noticias" class:list={['rounded-lg px-3 py-2 transition', isActive('/noticias') ? 'bg-white/10 font-bold text-white' : 'text-slate-400 hover:text-white']} aria-current={isActive('/noticias') ? 'page' : undefined}>Noticias</a>
        <a href="/articulos" class:list={['rounded-lg px-3 py-2 transition', isActive('/articulos') ? 'bg-white/10 font-bold text-white' : 'text-slate-400 hover:text-white']} aria-current={isActive('/articulos') ? 'page' : undefined}>Artículos</a>
      </nav>
    </div>
  </div>
  <!-- Overlay para cerrar al hacer clic afuera -->
  <div class="flex-grow cursor-pointer" id="drawer-overlay"></div>
</div>

<script>
  // Lógica del cliente ejecutada en el navegador
  const drawer = document.getElementById('drawer');
  const closeDrawerBtn = document.getElementById('close-drawer');
  const overlay = document.getElementById('drawer-overlay');
  
  // Escuchamos un evento personalizado que disparará el Header
  const closeDrawer = () => {
    drawer?.classList.add('-translate-x-full');
    drawer?.setAttribute('aria-hidden', 'true');
    document.getElementById('open-drawer')?.setAttribute('aria-expanded', 'false');
    document.getElementById('open-drawer')?.focus();
  };
  document.addEventListener('toggleDrawer', () => {
    drawer?.classList.remove('-translate-x-full');
    drawer?.setAttribute('aria-hidden', 'false');
    closeDrawerBtn?.focus();
  });

  closeDrawerBtn?.addEventListener('click', closeDrawer);
  overlay?.addEventListener('click', closeDrawer);
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && drawer?.getAttribute('aria-hidden') === 'false') closeDrawer();
  });
</script>
