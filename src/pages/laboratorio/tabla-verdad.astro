---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Laboratorio: tabla de verdad" description="Reto interactivo de lógica booleana.">
  <section class="mx-auto max-w-3xl px-4 py-12 sm:py-16"><a href="/tutoriales/diseno-booleano" class="text-sm font-bold text-amberBtn">← Volver al tutorial</a><p class="mt-8 text-xs font-bold uppercase tracking-[.2em] text-amberBtn">Mini laboratorio</p><h1 class="mt-2 text-4xl font-extrabold text-white">Reto de tabla de verdad</h1><p class="mt-4 text-slate-300">Activa las entradas y predice la salida de una compuerta AND. Solo obtienes un <code class="text-amberBtn">1</code> cuando ambas entradas están activas.</p><div class="mt-9 rounded-2xl border border-borderLine bg-black/40 p-6 sm:p-9"><div class="grid gap-5 sm:grid-cols-2"><button class="logic-toggle rounded-xl border border-borderLine bg-darkPage p-5 text-left transition hover:border-amberBtn" data-input="a" aria-pressed="false"><span class="text-xs font-bold uppercase tracking-widest text-slate-400">Entrada A</span><strong class="logic-value mt-2 block text-3xl text-white">0</strong></button><button class="logic-toggle rounded-xl border border-borderLine bg-darkPage p-5 text-left transition hover:border-amberBtn" data-input="b" aria-pressed="false"><span class="text-xs font-bold uppercase tracking-widest text-slate-400">Entrada B</span><strong class="logic-value mt-2 block text-3xl text-white">0</strong></button></div><div class="my-7 h-px bg-borderLine"></div><div class="flex items-center justify-between rounded-xl border border-amberBtn/40 bg-amberBtn/10 p-5"><div><p class="text-xs font-bold uppercase tracking-widest text-amberBtn">A AND B</p><p class="mt-1 text-sm text-slate-300">Salida del circuito</p></div><output class="logic-output text-5xl font-extrabold text-white" aria-live="polite">0</output></div><p class="logic-message mt-5 text-center text-sm text-slate-400" aria-live="polite">Activa ambas entradas para completar el reto.</p></div></section>
</BaseLayout>
<script>
  const state = { a: false, b: false }; const buttons = [...document.querySelectorAll<HTMLButtonElement>('.logic-toggle')]; const output = document.querySelector<HTMLOutputElement>('.logic-output'); const message = document.querySelector<HTMLElement>('.logic-message');
  const render = () => { const result = state.a && state.b; output!.textContent = result ? '1' : '0'; output?.classList.toggle('text-amberBtn', result); message!.textContent = result ? '¡Correcto! La compuerta AND está activa.' : 'Activa ambas entradas para completar el reto.'; buttons.forEach((button) => { const key = button.dataset.input as 'a' | 'b'; button.setAttribute('aria-pressed', String(state[key])); button.querySelector('.logic-value')!.textContent = state[key] ? '1' : '0'; button.classList.toggle('border-amberBtn', state[key]); }); };
  buttons.forEach((button) => button.addEventListener('click', () => { const key = button.dataset.input as 'a' | 'b'; state[key] = !state[key]; render(); }));
</script>
