---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Card from '../components/Card.astro';
import { sections, sectionSlugs } from '../lib/content';

const entries = await Promise.all(sectionSlugs.map(async (section) => ({
  section,
  posts: (await getCollection(section)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3),
})));
const featured = entries.flatMap(({ section, posts }) => posts.map((post) => ({ section, post }))).find(({ post }) => post.data.featured);
---

<BaseLayout title="Inicio" description="Tutoriales y laboratorios para aprender lógica digital, programación, hardware y software desde cero.">
  <div class="mx-auto w-full space-y-14 px-[var(--page-gutter)] py-6 sm:py-10" style="max-width: var(--site-max)">
    <Hero slides={[
      { eyebrow: 'Lógica digital', title: 'Aprende tecnología. Hazla tuya.', description: 'Tutoriales y laboratorios para aprender lógica digital, programación y hardware desde cero.', imageSrc: '/images/hero/circuits.svg', imageAlt: 'Circuitos digitales abstractos', ctaHref: '/tutoriales', ctaLabel: 'Ver tutoriales' },
      { eyebrow: 'Laboratorio interactivo', title: 'No solo leas: pruébalo.', description: 'Explora retos cortos, simulaciones y ejemplos listos para modificar.', imageSrc: '/images/hero/lab.svg', imageAlt: 'Panel abstracto de laboratorio técnico', ctaHref: '/laboratorio/tabla-verdad', ctaLabel: 'Abrir laboratorio' },
      { eyebrow: 'Aprendizaje continuo', title: 'Ideas que se convierten en práctica.', description: 'Guías, noticias y análisis para avanzar a tu propio ritmo.', imageSrc: '/images/hero/code.svg', imageAlt: 'Código y líneas de conexión abstractas', ctaHref: '/explorar', ctaLabel: 'Explorar temas' },
    ]} />

    {featured && (
      <section class="overflow-hidden rounded-2xl border border-amberBtn/30 bg-[#0b0d10]" aria-labelledby="featured-title">
        <div class="grid lg:grid-cols-[.82fr_1.18fr]">
          <div class="post-art-frame relative min-h-56 overflow-hidden"><img src={featured.post.data.heroImage} alt={featured.post.data.heroImageAlt || ''} class="post-art absolute inset-0 h-full w-full object-cover opacity-70" /><div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(0,0,0,.15),rgba(0,0,0,.78))]"></div><p class="absolute left-6 top-6 rounded-full border border-amberBtn/40 bg-black/60 px-3 py-1 text-[10px] font-bold uppercase tracking-[.17em] text-amberBtn backdrop-blur">Tema de la semana</p></div>
          <div class="flex flex-col justify-center p-7 sm:p-10"><p class="text-xs font-bold uppercase tracking-[.18em] text-amberBtn">{featured.post.data.category}</p><h2 id="featured-title" class="mt-3 max-w-xl text-2xl font-extrabold leading-tight text-white sm:text-4xl">{featured.post.data.title}</h2><p class="mt-4 max-w-2xl leading-7 text-slate-300">{featured.post.data.description}</p><div class="mt-7 flex flex-wrap items-center gap-3"><a href={`/${featured.section}/${featured.post.slug}`} class="rounded-lg bg-amberBtn px-5 py-3 text-sm font-bold text-black transition hover:bg-amberHover">Abrir tema</a><span class="text-xs text-slate-400">Lectura y práctica guiada</span></div></div>
        </div>
      </section>
    )}

    <section class="grid gap-4 rounded-xl border border-borderLine bg-black/30 p-6 md:grid-cols-3">
      <div class="md:col-span-2"><p class="text-xs font-bold uppercase tracking-[0.2em] text-amberBtn">Calvo Blog</p><h2 class="mt-2 text-2xl font-extrabold text-white">Conocimiento técnico, claro y sin ruido.</h2></div>
      <p class="text-sm leading-6 text-slate-300">Contenido estático, abierto y directo para practicar lógica digital, programación, hardware y software.</p>
    </section>

    {entries.map(({ section, posts }) => (
      <section class="space-y-5" aria-labelledby={`${section}-title`}>
        <div class="flex items-end justify-between gap-4 border-b border-borderLine pb-3">
          <div><p class="text-xs font-semibold uppercase tracking-widest text-amberBtn">{sections[section].singular}</p><h2 id={`${section}-title`} class="text-2xl font-bold text-white">{sections[section].label}</h2></div>
          <a href={`/${section}`} class="text-sm font-semibold text-slate-300 hover:text-amberBtn">Ver todo <span aria-hidden="true">→</span></a>
        </div>
        {posts.length ? <div class="grid grid-cols-1 gap-5 md:grid-cols-3">{posts.map((post) => <Card {...post.data} section={section} slug={post.slug} actionText={`Ver ${post.data.category}`} />)}</div> : <p class="text-slate-400">Próximamente habrá contenido en esta sección.</p>}
      </section>
    ))}
  </div>
</BaseLayout>
