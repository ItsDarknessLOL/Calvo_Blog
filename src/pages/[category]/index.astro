---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import { sections, sectionSlugs, type SectionSlug } from '../../lib/content';

export function getStaticPaths() {
  return sectionSlugs.map((category) => ({ params: { category } }));
}

const category = Astro.params.category as SectionSlug;
const section = sections[category];
const posts = (await getCollection(category)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={section.label} description={section.description}>
  <section class="mx-auto w-full px-[var(--page-gutter)] py-12 sm:py-16" style="max-width: var(--site-max)">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-amberBtn">Biblioteca</p>
    <h1 class="mt-2 text-4xl font-extrabold text-white">{section.label}</h1>
    <p class="mt-3 max-w-2xl text-slate-300">{section.description}</p>
    <div class="mt-10 grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => <Card {...post.data} section={category} slug={post.slug} actionText={`Ver ${post.data.category}`} />)}
    </div>
  </section>
</BaseLayout>
